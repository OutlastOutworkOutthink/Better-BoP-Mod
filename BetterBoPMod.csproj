<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BetterBoPMod</AssemblyName>
    <RootNamespace>BetterBoPMod</RootNamespace>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json;
      https://polymod.dev/nuget/v3/index.json;
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolyMod" Version="1.2.17" />
  </ItemGroup>

  <!--
    Alpha 0.5.9 compiles the locked Oblivion baseline plus the isolated Discord
    account-link module. The files below stay in git as implementation history,
    but none of their types enter the DLL.
  -->
  <ItemGroup>
    <Compile Remove="BetterBoPRules.cs" />
    <Compile Remove="DiscordIntegration.cs" />
    <Compile Remove="GiftStars.cs" />
    <Compile Remove="GrowGiant.cs" />
    <Compile Remove="IntegratedMultiplayer.cs" />
    <Compile Remove="MultiplayerRestrictions.cs" />
    <Compile Remove="TribeRelations.cs" />
  </ItemGroup>
</Project>
